# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app (never put secrets here).
# Use EAS environment variables for cloud builds.

# Base URL of the SparkSquad API (Cloudflare Worker). For a device on your LAN use your PC's IP.
EXPO_PUBLIC_API_URL=http://localhost:8787

# Google OAuth client IDs (Google Cloud Console > APIs & Services > Credentials)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Payments switch (must match the API). Off for the pilot.
EXPO_PUBLIC_PAYMENTS_ENABLED=false

# RevenueCat public SDK keys (only when payments are on)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Optional analytics / crash reporting. App runs without them.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=

# App Store page used by the force-update screen (Android uses the package id).
EXPO_PUBLIC_IOS_STORE_URL=

# EAS
EAS_PROJECT_ID=
APP_VARIANT=development
