{
  "name": "@sparksquad/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply sparksquad --local",
    "db:migrate:remote": "wrangler d1 migrations apply sparksquad --remote",
    "seed:templates": "tsx scripts/seed-templates.ts"
  },
  "dependencies": {
    "@sparksquad/shared": "workspace:*",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@cloudflare/workers-types": "^5.20261031.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
