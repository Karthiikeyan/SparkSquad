{
  "name": "@sparksquad/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "node scripts/deploy.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply sparksquad --local",
    "db:migrate:remote": "wrangler d1 migrations apply sparksquad --remote",
    "seed:templates": "node scripts/seed-templates.mjs"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.14",
    "@sparksquad/shared": "workspace:*",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@cloudflare/workers-types": "^5.20261031.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
