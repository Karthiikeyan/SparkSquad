# Non-secret overrides for the API. Secrets go in .dev.vars (see .dev.vars.example) or `wrangler secret put`.
# These mirror [vars] in wrangler.toml; edit wrangler.toml per environment.
APP_ENV=development
PAYMENTS_ENABLED=false
MIN_APP_VERSION=1.0.0
PUBLIC_API_URL=http://localhost:8787
ADMIN_EMAILS=you@example.com
EMAIL_FROM=SparkSquad <onboarding@resend.dev>
ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.sparktribe.sparksquad
IOS_STORE_URL=https://apps.apple.com/app/sparksquad
CONTACT_EMAIL=support@yourdomain.com
R2_BUCKET_NAME=sparksquad
# Pilot paywall display prices while PAYMENTS_ENABLED=false (empty shows "Price at launch").
PRICE_PLUS_MONTHLY=
PRICE_PLUS_YEARLY=
PRICE_SQUAD_PRO_MONTHLY=
PRICE_SQUAD_PRO_YEARLY=

# Only for scripts/seed-templates.mjs, when your D1 database or R2 bucket is not named "sparksquad".
D1_DATABASE_NAME=sparksquad
