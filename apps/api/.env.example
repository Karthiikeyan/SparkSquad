# Non-secret overrides for the API. Secrets go in .dev.vars (see .dev.vars.example) or `wrangler secret put`.
# These mirror [vars] in wrangler.toml; edit wrangler.toml per environment.
APP_ENV=development
PAYMENTS_ENABLED=false
MIN_APP_VERSION=1.0.0
PUBLIC_API_URL=http://localhost:8787
ADMIN_EMAILS=you@example.com
EMAIL_FROM=SparkSquad <onboarding@resend.dev>
